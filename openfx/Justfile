set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

TargetDir := env_var_or_default("CARGO_TARGET_DIR", "target")

[windows]
release:
    cargo build --release
    Copy-Item -Path "{{TargetDir}}\release\gyroflow_ofx.dll" -Destination "C:\Program Files\Common Files\OFX\Plugins\fpSupGyroflow.ofx.bundle\Contents\Win64\fpSupGyroflow.ofx" -Force

[windows]
deploy:
    #!powershell
    $ErrorActionPreference = 'Stop'

    cargo build --profile deploy
    cd "{{TargetDir}}"
    Remove-Item -Recurse -Force gyroflow-ofx-windows, fpSupGyroflow-OpenFX-windows.zip -ErrorAction SilentlyContinue
    New-Item -ItemType Directory -Path "gyroflow-ofx-windows/fpSupGyroflow.ofx.bundle/Contents/Win64" -Force
    cp "deploy/gyroflow_ofx.dll" "gyroflow-ofx-windows/fpSupGyroflow.ofx.bundle/Contents/Win64/fpSupGyroflow.ofx"
    cp "{{justfile_directory()}}/res/Info.plist" "gyroflow-ofx-windows/fpSupGyroflow.ofx.bundle/Contents/"
    cp "{{justfile_directory()}}/../LICENSE" "gyroflow-ofx-windows/fpSupGyroflow.ofx.bundle/Contents/"
    cp "{{justfile_directory()}}/res/Install-Windows.bat" "gyroflow-ofx-windows/"
    cd gyroflow-ofx-windows ; 7z a ../fpSupGyroflow-OpenFX-windows.zip .

[macos]
deploy:
    #!/bin/bash
    set -e

    rustup target add aarch64-apple-darwin
    rustup target add x86_64-apple-darwin

    cargo build --profile deploy --target x86_64-apple-darwin
    cargo build --profile deploy --target aarch64-apple-darwin

    version=$(grep '^version' Cargo.toml | sed -E 's/version = "(.+)".*/\1/')
    version_short=$(echo $version | sed -E 's/-.*//')

    if [[ "$GITHUB_REF" == *"tags"* ]]; then
        version="${version}.0"
        version_short="${version_short}.0"
    else
        if [[ -z "$GITHUB_RUN_NUMBER" ]]; then
            version="${version}-dev"
            version_short="${version_short}.1"
        else
            version="${version}.${GITHUB_RUN_NUMBER}"
            version_short="${version_short}.${GITHUB_RUN_NUMBER}"
        fi
    fi

    # A fork without the Apple certificate signs ad hoc (no notarization).
    if [[ -n "$SIGNING_FINGERPRINT" ]]; then SIGN="--options=runtime --timestamp -s $SIGNING_FINGERPRINT"; else SIGN="-s -"; fi
    cd "{{TargetDir}}"
    rm -Rf gyroflow-ofx-macos fpSupGyroflow-OpenFX-macos.dmg
    mkdir -p gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/MacOS

    lipo {x86_64,aarch64}-apple-darwin/deploy/libgyroflow_ofx.dylib -create -output gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/MacOS/fpSupGyroflow.dylib
    cp "{{justfile_directory()}}/res/Info.plist" gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/
    # LICENSE in Contents/Resources: in Contents/ itself codesign keeps its signature in extended
    # attributes, which zip drops, so the unzipped bundle failed codesign --verify --deep.
    mkdir -p gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/Resources
    cp "{{justfile_directory()}}/../LICENSE"     gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/Resources/

    /usr/libexec/PlistBuddy -c "add CFBundleVersion string $version_short" gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/Info.plist
    /usr/libexec/PlistBuddy -c "add CFBundleShortVersionString string $version" gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/Info.plist

    codesign -vvvv --strict --force $SIGN gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/MacOS/fpSupGyroflow.dylib
    mv gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/MacOS/fpSupGyroflow.dylib gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle/Contents/MacOS/fpSupGyroflow.ofx

    codesign -vvvv --deep --strict --force $SIGN gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle
    codesign -vvvv --deep --verify gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle

    pushd gyroflow-ofx-macos
        zip -r ../fpSupGyroflow-OpenFX-macos.zip fpSupGyroflow.ofx.bundle
    popd

    # An installer package, as sigma-fp-raw ships: right-click > Open, then the installer;
    # no Terminal step, as files a package installs carry no quarantine. Not relocatable:
    # otherwise Installer puts it wherever another copy of the bundle id already sits.
    rm -rf pkgroot component.plist fpSupGyroflow-OpenFX-macos.pkg && mkdir pkgroot
    ditto gyroflow-ofx-macos/fpSupGyroflow.ofx.bundle pkgroot/fpSupGyroflow.ofx.bundle
    pkgbuild --analyze --root pkgroot component.plist
    plutil -replace 0.BundleIsRelocatable -bool NO component.plist && plutil -replace 0.BundleIsVersionChecked -bool NO component.plist
    pkgbuild --root pkgroot --component-plist component.plist --identifier io.github.ijigen.fpsup.gyroflow.pkg --version "$version" --install-location /Library/OFX/Plugins fpSupGyroflow-OpenFX-macos.pkg

    ln -sf /Library/OFX/Plugins "gyroflow-ofx-macos/"
    hdiutil create "fpSupGyroflow-OpenFX-macos.dmg" -volname "Gyroflow OpenFX plugin" -fs HFS+ -srcfolder "gyroflow-ofx-macos/" -ov -format UDZO -imagekey zlib-level=9

    codesign -vvvv --strict --force $SIGN "fpSupGyroflow-OpenFX-macos.dmg"
    codesign -vvvv --deep --verify "fpSupGyroflow-OpenFX-macos.dmg"

[linux]
deploy:
    #!/bin/bash
    set -e

    cargo build --profile deploy
    cd "{{TargetDir}}"
    rm -Rf gyroflow-ofx-linux fpSupGyroflow-OpenFX-linux.zip
    mkdir -p gyroflow-ofx-linux/fpSupGyroflow.ofx.bundle/Contents/Linux-x86-64
    cp deploy/libgyroflow_ofx.so gyroflow-ofx-linux/fpSupGyroflow.ofx.bundle/Contents/Linux-x86-64/fpSupGyroflow.ofx
    cp "{{justfile_directory()}}/res/Info.plist" gyroflow-ofx-linux/fpSupGyroflow.ofx.bundle/Contents/
    cp "{{justfile_directory()}}/../LICENSE"     gyroflow-ofx-linux/fpSupGyroflow.ofx.bundle/Contents/
    cd gyroflow-ofx-linux && zip -r ../fpSupGyroflow-OpenFX-linux.zip .
